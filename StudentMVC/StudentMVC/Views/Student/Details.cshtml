@model StudentMVC.Models.Student

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Student Details</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                margin: 40px;
            }

            .student-card {
                width: 450px;
                padding: 25px;
                border: 1px solid #ccc;
                border-radius: 10px;
            }

            h1 {
                margin-bottom: 20px;
            }

            p {
                font-size: 18px;
                margin: 10px 0;
            }
    </style>
</head>

<body>

    <div class="student-card">
        <h1>Student Details</h1>

        <p><strong>Student ID:</strong> @Model.StudentId</p>
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Course:</strong> @Model.Course</p>
        <p><strong>Marks:</strong> @Model.Marks</p>

        @if (Model.Marks >= 40)
        {
            <p><strong>Result:</strong> Pass</p>
        }
        else
        {
            <p><strong>Result:</strong> Fail</p>
        }
    </div>

</body>
</html>