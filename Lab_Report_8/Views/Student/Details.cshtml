@model MVCViewsDemo.Models.Student

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Student Details</title>

    <style>
            body {
                font-family: Arial, sans-serif;
                background-color: #f2f2f2;
                margin: 0;
                padding: 50px;
            }

            .container {
                width: 500px;
                margin: auto;
                background: white;
                padding: 30px;
                border-radius: 10px;
                box-shadow: 0 0 10px rgba(0,0,0,0.2);
            }

            h1 {
                text-align: center;
                color: #333;
            }

            p {
                font-size: 18px;
                padding: 8px;
                border-bottom: 1px solid #ddd;
            }

            strong {
                color: #555;
            }
    </style>
</head>

<body>

    <div class="container">

        <h1>Student Details</h1>

        <p>
            <strong> Student ID:</strong> @Model.Id
        </p>

        <p>
            <strong>Name:</strong> @Model.Name
        </p>

        <p>
            <strong>Faculty:</strong> @Model.Course
        </p>

        <p>
            <strong>Age:</strong> @Model.Age
        </p>

        <p>
            <strong>Semester:</strong> @Model.Semester
        </p>

    </div>

</body>
</html>