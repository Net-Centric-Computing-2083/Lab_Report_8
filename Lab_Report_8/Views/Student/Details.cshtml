@model MVCDemo.Models.Student

<!DOCTYPE html>
<html>
<head>
    <title>Student Details</title>
</head>
<body>

    <h1>Student Details</h1>

    <p><strong>Student ID:</strong> @Model.Id</p>
    <p><strong>Name:</strong> @Model.Name</p>
    <p><strong>Age:</strong> @Model.Age</p>
    <p><strong>Address:</strong> @Model.Address</p>
    <p><strong>Semester:</strong> @Model.Semester</p>

    @if (Model.Semester >= 6)
    {
        <p>Student is in a senior semester.</p>
    }
    else
    {
        <p>Student is in a junior semester.</p>
    }

</body>
</html>
