@model Lab_Report_8.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-5">
    <h1>Student Details</h1>

    <hr />

    <table class="table table-bordered">
        <tr>
            <th>Student ID</th>
            <td>@Model.Id</td>
        </tr>

        <tr>
            <th>Name</th>
            <td>@Model.Name</td>
        </tr>

        <tr>
            <th>Roll Number</th>
            <td>@Model.RollNumber</td>
        </tr>

        <tr>
            <th>Program</th>
            <td>@Model.Program</td>
        </tr>

        <tr>
            <th>Semester</th>
            <td>@Model.Semester</td>
        </tr>
    </table>
</div>